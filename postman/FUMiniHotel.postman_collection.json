            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerFullName\": \"Postman Customer\",\n  \"telephone\": \"0901234567\",\n  \"emailAddress\": \"{{newEmail}}\",\n  \"customerBirthday\": \"2000-01-01\",\n  \"customerStatus\": 1,\n  \"password\": \"Customer@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
