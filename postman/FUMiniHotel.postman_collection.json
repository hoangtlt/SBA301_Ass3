{
  "info": {
    "name": "FU Mini Hotel - Assignment 03",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run folders in order against a fresh demo backend. Dynamic dates, JWT capture, CRUD cleanup and expected authorization failures included."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "staffEmail",
      "value": "staff@fuminihotel.com"
    },
    {
      "key": "staffPassword",
      "value": "Staff@123"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "newEmail",
      "value": ""
    },
    {
      "key": "roomId1",
      "value": ""
    },
    {
      "key": "roomId2",
      "value": ""
    },
    {
      "key": "roomTypeId",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "staffCreatedCustomerId",
      "value": ""
    },
    {
      "key": "newRoomId",
      "value": ""
    },
    {
      "key": "customerBookingId",
      "value": ""
    },
    {
      "key": "staffBookingId",
      "value": ""
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "staffToken",
      "value": ""
    },
    {
      "key": "startDate",
      "value": ""
    },
    {
      "key": "endDate",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function dateAfter(days) { const d = new Date(); d.setDate(d.getDate() + days); return d.getFullYear() + \"-\" + String(d.getMonth() + 1).padStart(2, \"0\") + \"-\" + String(d.getDate()).padStart(2, \"0\"); }",
          "pm.collectionVariables.set(\"startDate\", dateAfter(3));",
          "pm.collectionVariables.set(\"endDate\", dateAfter(5));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Public",
      "item": [
        {
          "name": "List rooms and initialize test run",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/rooms",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const rooms = pm.response.json();",
                  "pm.test(\"At least two active seed rooms\", () => pm.expect(rooms.length).to.be.at.least(2));",
                  "if (rooms.length >= 2) { pm.collectionVariables.set(\"roomId1\", rooms[0].roomId); pm.collectionVariables.set(\"roomId2\", rooms[1].roomId); }"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", Date.now().toString());",
                  "pm.collectionVariables.set(\"newEmail\", \"postman-\" + pm.collectionVariables.get(\"runId\") + \"@example.com\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Room details",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/rooms/{{roomId1}}",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Room types",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/room-types",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"roomTypeId\", pm.response.json()[0].roomTypeId);"
                ]
              }
            }
          ]
        }
      ]
    },
